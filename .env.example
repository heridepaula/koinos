# Copie para .env.local e preencha. Nunca versione o .env.local.

# MongoDB Atlas
# mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/koinos?retryWrites=true&w=majority&appName=koinos
MONGODB_URI=

# Redis (sessões e rate limit). Prefira rediss:// (TLS) se o seu plano permitir.
# redis://default:SENHA@SEU-HOST.cloud.redislabs.com:PORTA
REDIS_URL=

# Better Auth
# Gere o segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth)
# URI de redirecionamento: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mails autorizados a entrar, separados por vírgula
ALLOWED_EMAILS=

# brapi.dev (opcional: sem token, só a listagem em lote funciona)
BRAPI_TOKEN=
BRAPI_MONTHLY_QUOTA=15000

# Protege /api/cron/daily (obrigatório em produção, 16+ caracteres)
CRON_SECRET=
